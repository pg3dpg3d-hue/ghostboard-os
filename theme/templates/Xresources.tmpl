! {{meta.os_name}} — X resources. GÉNÉRÉ. NE PAS ÉDITER.
! Rendu de police : la dalle 800x480 est petite, le sous-pixel aide beaucoup.
Xft.antialias:  1
Xft.hinting:    1
Xft.hintstyle:  hintslight
Xft.rgba:       rgb
Xft.lcdfilter:  lcddefault
Xft.dpi:        96

! Curseur X racine (visible ~200 ms avant le démarrage de la session)
*background: {{bg}}
*foreground: {{text}}
*cursorColor: {{accent}}

! Repli xterm — sert si XFCE ne démarre pas et qu'on est en secours SSH/console
XTerm*faceName: {{font.mono}}
XTerm*faceSize: {{font.term_pt}}
XTerm*background: {{bg}}
XTerm*foreground: {{text}}
XTerm*color0:  {{term.black}}
XTerm*color1:  {{term.red}}
XTerm*color2:  {{term.green}}
XTerm*color3:  {{term.yellow}}
XTerm*color4:  {{term.blue}}
XTerm*color5:  {{term.magenta}}
XTerm*color6:  {{term.cyan}}
XTerm*color7:  {{term.white}}
XTerm*color8:  {{term.bright_black}}
XTerm*color9:  {{term.bright_red}}
XTerm*color10: {{term.bright_green}}
XTerm*color11: {{term.bright_yellow}}
XTerm*color12: {{term.bright_blue}}
XTerm*color13: {{term.bright_magenta}}
XTerm*color14: {{term.bright_cyan}}
XTerm*color15: {{term.bright_white}}
