# {{meta.os_name}} — décorations de fenêtre xfwm4. GÉNÉRÉ. NE PAS ÉDITER.
#
# Aucune image de barre de titre n'est fournie : xfwm4 retombe alors sur des
# aplats de couleur. C'est exactement ce qu'on veut — Windows 11 a des barres
# de titre plates. Seuls les boutons sont des PNG (générés par render-theme.py).
#
# Boutons à DROITE, ordre minimiser / maximiser / fermer : imposé côté xfconf
# (button_layout), pas ici.

active_text_color=#{{text_nohash}}
active_text_shadow_color=#{{bg_nohash}}
inactive_text_color=#{{text_dim_nohash}}
inactive_text_shadow_color=#{{bg_nohash}}

# Barre de titre active : le panneau. Inactive : le fond. Aucun dégradé.
active_hilight_1=#{{panel_nohash}}
active_hilight_2=#{{panel_nohash}}
active_mid_1=#{{panel_nohash}}
active_mid_2=#{{panel_nohash}}
active_shadow_1=#{{panel_nohash}}
active_shadow_2=#{{panel_nohash}}
active_color_1=#{{panel_nohash}}
active_color_2=#{{panel_nohash}}

inactive_hilight_1=#{{bg_nohash}}
inactive_hilight_2=#{{bg_nohash}}
inactive_mid_1=#{{bg_nohash}}
inactive_mid_2=#{{bg_nohash}}
inactive_shadow_1=#{{bg_nohash}}
inactive_shadow_2=#{{bg_nohash}}
inactive_color_1=#{{bg_nohash}}
inactive_color_2=#{{bg_nohash}}

title_shadow_active=false
title_shadow_inactive=false
title_horizontal_offset=8
title_vertical_offset_active=1
title_vertical_offset_inactive=1
button_offset=2
button_spacing=1
full_width_title=true
maximized_offset=0

# Ombres portées : coupées. Une ombre coûte du compositeur pour rien sur
# une dalle de 4 pouces où les fenêtres sont quasi toujours plein écran.
shadow_delta_x=0
shadow_delta_y=0
shadow_delta_width=0
shadow_delta_height=0
shadow_opacity=0
