#!/usr/bin/env bash
# ============================================================================
#  GHOSTBOARD OS — lanceur de Claude Code
# ============================================================================
#  Claude Code est le cœur du système : accès terminal + fichiers, et il
#  orchestre le reste (dont le serveur MCP computer use).
#
#  MODE DÉGRADÉ : le raisonnement est dans le cloud. Sans réseau, Claude Code
#  ne peut pas fonctionner. Ce lanceur le dit franchement AVANT d'ouvrir une
#  session qui échouerait, et rappelle ce qui reste utilisable hors ligne.
#  Il ne bloque jamais : on peut toujours forcer le lancement.
# ============================================================================
set -uo pipefail
SHARE="${GHOSTBOARD_SHARE:-/usr/share/ghostboard}"
workspace="${GHOSTBOARD_DEV_REPO:-$HOME/Ghostboard}"
[[ -d "$workspace/.git" ]] && cd "$workspace"
[[ -f "$SHARE/palette.sh" ]] && . "$SHARE/palette.sh"

c()   { [[ -t 1 ]] || { printf '%s' "$2"; return; }
        local h="${1#\#}"
        printf '\033[38;2;%d;%d;%dm%s\033[0m' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}" "$2"; }
accent() { c "${GB_ACCENT:-#A855F7}" "$1"; }
warn()   { c "${GB_INPUT:-#FF4D8D}" "$1"; }
faint()  { c "${GB_TEXT_DIM:-#6E6880}" "$1"; }

# ---------------------------------------------------------------------------
#  Mode LOCAL : router Claude Code sur le modèle local (LM Studio · Dolphin).
#  Claude Code parle l'API Anthropic ; ghost-llm-proxy la traduit vers LM Studio.
#  On lance le proxy, on pointe ANTHROPIC_BASE_URL dessus, puis claude.
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "--local" ]]; then
  shift
  command -v claude >/dev/null 2>&1 || { echo "$(warn 'Claude Code n'\''est pas installé.')"; exit 1; }
  command -v ghost-llm-proxy >/dev/null 2>&1 ||     { echo "$(warn 'ghost-llm-proxy absent — relance install/steps/50-theme.')"; exit 1; }

  llm_base="${GHOSTBOARD_LLM_BASE:-http://127.0.0.1:1234/v1}"
  if ! curl -fsS --max-time 3 "$llm_base/models" >/dev/null 2>&1; then
    echo "$(warn '  LM Studio injoignable ('"$llm_base"').')"
    echo "$(faint '  Démarre son serveur (lms server start) puis : ghost-llm --check')"
    exit 1
  fi

  port="${GHOSTBOARD_PROXY_PORT:-8788}"
  ghost-llm-proxy --port "$port" --lm "$llm_base" >/dev/null 2>&1 &
  proxy_pid=$!
  # attendre que le proxy réponde
  for _ in $(seq 1 40); do
    curl -fsS --max-time 1 "http://127.0.0.1:$port/health" >/dev/null 2>&1 && break
    sleep 0.1
  done
  # le proxy meurt avec ce shell (pas d'exec : le trap doit se déclencher)
  trap '[[ -n "${proxy_pid:-}" ]] && kill "$proxy_pid" 2>/dev/null' EXIT INT TERM

  model="$(curl -fsS --max-time 3 "http://127.0.0.1:$port/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)"
  model="${model:-local-model}"

  export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
  export ANTHROPIC_API_KEY="lm-studio"          # LM Studio ignore la clé
  export ANTHROPIC_MODEL="$model"
  export ANTHROPIC_SMALL_FAST_MODEL="$model"    # pas de repli haiku distant

  echo "$(accent '  GHOSTBOARD') $(faint "— Claude Code sur le modèle LOCAL : $model")"
  echo "$(warn '  Modèle local : la boucle agentique (outils, édition) sera limitée.')"
  echo "$(faint '  Chat et édition simple passent ; l'\''agentique complexe non. Ctrl+C pour sortir.')"
  echo
  claude "$@"
  exit $?
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "$(warn 'Claude Code n'\''est pas installé.')"
  echo "$(faint '  sudo ghostboard-install --step 60-nodejs-claude-code')"
  exit 1
fi

# Sonde réseau : 2 s, sans DNS lent. On teste l'API réellement utilisée, pas
# « internet » en général — un portail captif répond, l'API non.
online=0
if command -v curl >/dev/null 2>&1; then
  curl -fsS --max-time 2 -o /dev/null "https://api.anthropic.com/v1/models" 2>/dev/null && online=1
  # 401 = joignable mais non authentifié : le réseau est bon, c'est ce qu'on teste.
  [[ "$online" -eq 0 ]] && \
    [[ "$(curl -s --max-time 2 -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/models 2>/dev/null)" =~ ^(401|403|200)$ ]] && online=1
fi

if [[ "$online" -eq 0 ]]; then
  echo
  echo "$(warn '  ── HORS LIGNE ─────────────────────────────────────')"
  echo "  L'API Anthropic n'est pas joignable."
  echo "  Le raisonnement de Claude est dans le cloud : sans réseau,"
  echo "  Claude Code ne peut pas répondre."
  echo
  echo "$(accent '  Raisonnement LOCAL disponible : ghost-llm')"
  echo "$(faint '    Le deck a son propre LLM (LM Studio · Dolphin). Sans réseau,')"
  echo "$(faint '    ghost-llm répond quand même — c'"'"'est le mode local.')"
  echo
  echo "$(faint '  Ce qui reste utilisable hors ligne :')"
  echo "$(faint '    ghost-llm      LLM local (Dolphin via LM Studio)')"
  echo "$(faint '    ghost-bruce    cartes ESP32, console série, WebUI locale')"
  echo "$(faint '    ghost-status   état du système')"
  echo "$(faint '    ghost-bench    mesures de performance')"
  echo "$(faint '    terminal, éditeur, gestionnaire de fichiers : intacts')"
  echo
  echo "$(faint '  Réseau : nmtui  (Wi-Fi)   ou branche un câble.')"
  echo
  read -r -p "  Lancer Claude Code quand même ? [o/N] " reply
  [[ "$reply" =~ ^[oOyY]$ ]] || exit 0
else
  echo "$(accent '  GHOSTBOARD') $(faint '— API Anthropic joignable')"
fi

exec claude "$@"
